# ─────────────────────────────────────────────────────────────
# Evoluno — Variables d'environnement (exemple)
# Copier vers .env :  cp .env.example .env
# .env est gitignoré ; seul cet exemple est committé.
# ─────────────────────────────────────────────────────────────

# --- Base de données (PostgreSQL 16+) ---
# Démo locale via Docker :
#   docker run -d --name evoluno-db -e POSTGRES_USER=evoluno \
#     -e POSTGRES_PASSWORD=evoluno_dev -e POSTGRES_DB=evoluno \
#     -p 5432:5432 --restart unless-stopped postgres:16
DATABASE_URL="postgresql://evoluno:evoluno_dev@localhost:5432/evoluno?schema=public"

# --- Chiffrement des tokens OAuth (AES-256-GCM — Constitution art. VI) ---
# 32 bytes en hexadécimal (64 caractères). Générer :
#   openssl rand -hex 32
ENCRYPTION_SECRET_KEY=""

# --- Auth.js / NextAuth v5 (module 001, tâches T005+) ---
# Générer AUTH_SECRET :
#   openssl rand -base64 32
AUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
GITLAB_ID=""
GITLAB_SECRET=""
